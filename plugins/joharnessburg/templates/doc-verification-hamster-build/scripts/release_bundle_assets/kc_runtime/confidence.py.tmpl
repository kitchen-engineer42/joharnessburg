"""Composite confidence scoring for verification findings.

Per [[confidence-system]]:
  confidence = method_prior * source_presence * historical_accuracy * (1 - corner_proximity)

Plus corner-case proximity matching (multiple pattern kinds supported).

Project: {{ PROJECT_NAME }}
Severity vocab: {{ SEVERITY_VOCAB_DISPLAY }}
"""

import hashlib
import re

# Method priors per check_R<id>.py / workflow.py implementation strategy.
# Override values for the project's domain by editing this dict.
METHOD_PRIORS = {
    "regex": 0.95,
    "python": 0.90,
    "hybrid": 0.75,
    "llm": 0.75,
    "ocr": 0.65,
    "fallback": 0.50,
}


def compute_confidence(
    method_prior: str,
    source_presence: float,
    historical_accuracy: float,
    corner_proximity: float,
) -> float:
    """Apply the composite formula.

    Args:
        method_prior: key into METHOD_PRIORS, or a numeric override (str of a float).
        source_presence: in [0, 1].
        historical_accuracy: in [0, 1] — typically the rule's weighted_accuracy from calibration.
        corner_proximity: in [0, 1] — proximity to the closest matching corner case.
    """
    # Method prior can be a string key or numeric override
    if isinstance(method_prior, (int, float)):
        prior = float(method_prior)
    elif isinstance(method_prior, str):
        try:
            prior = float(method_prior)
        except ValueError:
            prior = METHOD_PRIORS.get(method_prior, METHOD_PRIORS["fallback"])
    else:
        prior = METHOD_PRIORS["fallback"]

    prior = _clip(prior)
    source_presence = _clip(source_presence)
    historical_accuracy = _clip(historical_accuracy)
    corner_proximity = _clip(corner_proximity)

    return prior * source_presence * historical_accuracy * (1.0 - corner_proximity)


def match_corner_case(cc: dict, raw_finding: dict, doc: dict) -> float:
    """Return proximity in [0, 1] for one corner case against the current finding.

    Pattern kinds supported:
      - exact_doc_match  (sha256 of doc text)
      - structural       (list of {path: ..., equals: ...} matchers)
      - regex            (a regex applied to doc text)
    """
    pattern = cc.get("pattern", {})
    kind = pattern.get("kind")

    if kind == "exact_doc_match":
        doc_text = doc.get("text", "")
        fp = hashlib.sha256(doc_text.encode("utf-8")).hexdigest()
        expected = pattern.get("fingerprint", "").replace("sha256:", "")
        return 1.0 if fp == expected else 0.0

    if kind == "structural":
        matchers = pattern.get("matchers", [])
        if not matchers:
            return 0.0
        hits = 0
        for m in matchers:
            path = m.get("path", "").split(".")
            expected = m.get("equals")
            value = raw_finding
            try:
                for p in path:
                    if isinstance(value, dict):
                        value = value.get(p)
                    else:
                        value = getattr(value, p, None)
                if value == expected:
                    hits += 1
            except Exception:
                continue
        return hits / len(matchers)

    if kind == "regex":
        rx = pattern.get("pattern", "")
        if not rx:
            return 0.0
        try:
            return 1.0 if re.search(rx, doc.get("text", "")) else 0.0
        except re.error:
            return 0.0

    return 0.0


def _clip(v: float) -> float:
    try:
        v = float(v)
    except (TypeError, ValueError):
        return 0.0
    return max(0.0, min(1.0, v))
