"""Optional two-column PDF review dashboard for {{ PROJECT_NAME }}.

Renders an HTML page with the original PDF on the left (via pdf.js) and
findings on the right; clicking a finding jumps to the relevant PDF page.

Heavier than the basic dashboard (ships pdf.js as a dependency).
Only included when the bundle was scaffolded with --pdf-review-dashboard.

This file ships as a starting scaffold; the dev team customizes the
layout, finding-to-page mapping logic, and any project-specific PDF
annotation patterns post-scaffold.
"""

import html
import json
from pathlib import Path


PDFJS_CDN = "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"


def render_pdf_review(result: dict, pdf_path: Path, output: Path) -> None:
    """Render the PDF review HTML.

    Args:
        result: a result.json structure (single-doc only; multi-doc not supported).
        pdf_path: path to the source PDF (relative path from `output` is recommended).
        output: where to write the HTML.
    """
    findings = result.get("findings", [])
    pdf_url = str(pdf_path)

    finding_items = []
    for f in findings:
        page_hint = _extract_page_hint(f.get("citation", ""))
        page_attr = f' data-page="{page_hint}"' if page_hint else ""
        finding_items.append(f"""
<li class="finding" {page_attr}>
  <div class="finding-header">
    <strong>{html.escape(f["rule_id"])}</strong>
    <span class="verdict v-{html.escape(f["verdict"])}">{html.escape(f["verdict"])}</span>
    <span class="conf">{f["confidence"]:.2f}</span>
  </div>
  <div class="finding-body">{html.escape(f.get("evidence", "")[:240])}</div>
  <div class="finding-citation">{html.escape(f.get("citation", ""))}</div>
</li>""")

    html_body = f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{html.escape(pdf_path.name)} — PDF Review</title>
<style>
body {{ font-family: -apple-system, BlinkMacSystemFont, sans-serif; margin: 0; display: flex; height: 100vh; }}
#pdf-pane {{ flex: 1; overflow: auto; background: #2c2c2c; padding: 10px; }}
#findings-pane {{ width: 420px; overflow: auto; padding: 16px; background: #f9f9f9; border-left: 1px solid #ccc; }}
#findings-pane h2 {{ margin-top: 0; }}
canvas {{ display: block; margin: 0 auto 10px; background: white; box-shadow: 0 2px 6px rgba(0,0,0,0.5); }}
.finding {{ list-style: none; padding: 12px; margin-bottom: 8px; background: white; border-radius: 4px; cursor: pointer; border-left: 3px solid #ccc; }}
.finding:hover {{ box-shadow: 0 2px 8px rgba(0,0,0,0.1); }}
.finding-header {{ display: flex; gap: 8px; align-items: center; margin-bottom: 6px; }}
.verdict {{ padding: 2px 6px; border-radius: 3px; font-size: 0.75em; font-weight: 600; }}
.v-fail {{ background: #e74c3c; color: white; }}
.v-pass {{ background: #27ae60; color: white; }}
.v-needs-review {{ background: #f39c12; color: white; }}
.v-error {{ background: #95a5a6; color: white; }}
.conf {{ color: #888; font-size: 0.85em; margin-left: auto; }}
.finding-body {{ font-size: 0.85em; color: #444; margin-bottom: 4px; }}
.finding-citation {{ font-size: 0.75em; color: #888; }}
ul {{ padding: 0; margin: 0; }}
</style>
</head>
<body>
<div id="pdf-pane"><div id="pdf-container"></div></div>
<div id="findings-pane">
  <h2>{len(findings)} finding(s)</h2>
  <ul>{''.join(finding_items)}</ul>
</div>
<script src="{PDFJS_CDN}"></script>
<script>
const PDF_URL = {json.dumps(pdf_url)};
pdfjsLib.GlobalWorkerOptions.workerSrc = "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";

(async () => {{
  const pdf = await pdfjsLib.getDocument(PDF_URL).promise;
  const container = document.getElementById("pdf-container");
  for (let pageNum = 1; pageNum <= pdf.numPages; pageNum++) {{
    const page = await pdf.getPage(pageNum);
    const viewport = page.getViewport({{scale: 1.2}});
    const canvas = document.createElement("canvas");
    canvas.id = "page-" + pageNum;
    canvas.width = viewport.width;
    canvas.height = viewport.height;
    container.appendChild(canvas);
    await page.render({{canvasContext: canvas.getContext("2d"), viewport}}).promise;
  }}
}})();

document.querySelectorAll(".finding").forEach(el => {{
  el.addEventListener("click", () => {{
    const page = el.dataset.page;
    if (page) {{
      const target = document.getElementById("page-" + page);
      if (target) target.scrollIntoView({{behavior: "smooth", block: "start"}});
    }}
  }});
}});
</script>
</body>
</html>
"""
    output.write_text(html_body)


def _extract_page_hint(citation: str) -> str:
    """Best-effort: extract a page number from a citation string.

    Customize per project's citation format. Default looks for "page N" / "p.N".
    """
    import re
    m = re.search(r"(?:page|p\.?)\s*(\d+)", citation, re.IGNORECASE)
    return m.group(1) if m else ""
