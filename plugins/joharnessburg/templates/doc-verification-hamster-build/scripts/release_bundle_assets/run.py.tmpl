#!/usr/bin/env python3
"""Standalone driver for {{ PROJECT_NAME }} verification — kc_cli-style.

Runs the distilled workflows in this bundle against an input doc (or batch),
applies the confidence composite + corner-case registry per rule, and emits
result.json (+ optionally an HTML dashboard).

This bundle has NO dependency on John or the joharnessburg plugin at runtime.
It needs only:
  - Python 3.10+
  - LLM_API_KEY, LLM_BASE_URL env vars (for cheap-LLM calls)
  - TIER1..TIER4 env vars OR models.json with tier→model mappings
  - Optional: JOHN_PPX_CLIENT_URL for PDF parsing (falls back to markitdown)

Generated: {{ BUILD_DATE }}
Rules in bundle: {{ RULE_COUNT }}
Severity vocabulary: {{ SEVERITY_VOCAB_DISPLAY }}

Usage:
  python run.py <input-doc> [--rule R042] [--output result.json] [--dashboard]
  python run.py --batch <input-dir> [--output <output-dir>]
"""

import argparse
import importlib.util
import json
import os
import sys
from datetime import datetime, timezone
from pathlib import Path


BUNDLE_ROOT = Path(__file__).resolve().parent

# Ensure bundle's kc_runtime is importable
sys.path.insert(0, str(BUNDLE_ROOT))


def err(msg: str) -> None:
    print(f"ERROR: {msg}", file=sys.stderr)


def info(msg: str) -> None:
    print(msg, file=sys.stderr)


def load_workflow(rule_id: str):
    """Import workflows/<rule_id>/workflow.py dynamically."""
    workflow_path = BUNDLE_ROOT / "workflows" / rule_id / "workflow.py"
    if not workflow_path.exists():
        return None
    spec = importlib.util.spec_from_file_location(
        f"workflows.{rule_id}.workflow", workflow_path
    )
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    if not hasattr(module, "workflow"):
        err(f"workflow.py for {rule_id} has no `workflow` function")
        return None
    return module.workflow


def load_corner_cases(rule_id: str) -> list:
    """Optional per-rule corner-case registry."""
    # Bundled corner cases live next to workflows
    cc_path = BUNDLE_ROOT / "workflows" / rule_id / "corner-cases.json"
    if not cc_path.exists():
        return []
    try:
        data = json.loads(cc_path.read_text())
        return data.get("entries", [])
    except json.JSONDecodeError:
        err(f"failed to parse corner-cases.json for {rule_id}; ignoring")
        return []


def parse_input(doc_path: Path) -> dict:
    """Multi-level parse: markdown direct, PDF via ppx if available, else markitdown."""
    suffix = doc_path.suffix.lower()
    if suffix in {".md", ".txt"}:
        return {
            "text": doc_path.read_text(),
            "source_path": str(doc_path),
            "parser": "direct",
        }
    if suffix == ".pdf":
        ppx_url = os.environ.get("JOHN_PPX_CLIENT_URL")
        if ppx_url:
            try:
                import urllib.request
                import urllib.parse
                req = urllib.request.Request(
                    f"{ppx_url}/parse",
                    data=json.dumps({"input_path": str(doc_path)}).encode(),
                    headers={"Content-Type": "application/json"},
                    method="POST",
                )
                with urllib.request.urlopen(req, timeout=120) as resp:
                    parsed = json.loads(resp.read())
                return {
                    "text": parsed.get("text", ""),
                    "source_path": str(doc_path),
                    "parser": "ppx",
                }
            except Exception as e:
                err(f"ppx parse failed ({e}); falling back to markitdown")
    # markitdown fallback (or DOCX, HTML, etc.)
    try:
        from markitdown import MarkItDown
        md = MarkItDown()
        result = md.convert(str(doc_path))
        return {
            "text": result.text_content,
            "source_path": str(doc_path),
            "parser": "markitdown",
        }
    except ImportError:
        err("markitdown not installed; install with: pip install markitdown")
        err("or set JOHN_PPX_CLIENT_URL to use the ppx parser instead")
        sys.exit(1)


def verify_doc(doc: dict, rule_ids: list, catalog: dict, calibration: dict) -> list:
    """Run each rule's workflow against the doc; return findings."""
    from kc_runtime.confidence import compute_confidence

    findings = []
    for rule_id in rule_ids:
        rule_meta = catalog.get("rules", {}).get(rule_id) or \
            next((r for r in catalog if r.get("id") == rule_id), None)
        if rule_meta is None:
            err(f"rule {rule_id} not in catalog; skipping")
            continue

        workflow = load_workflow(rule_id)
        if workflow is None:
            err(f"no workflow.py for {rule_id}; skipping")
            continue

        try:
            raw = workflow(doc)
        except Exception as e:
            err(f"workflow for {rule_id} raised {type(e).__name__}: {e}")
            raw = {
                "verdict": "error",
                "confidence": 0.0,
                "evidence": str(e),
                "citation": "",
                "evidence_method": "fallback",
                "source_presence": 0.0,
            }

        # Apply corner-case lookup
        corner_cases = load_corner_cases(rule_id)
        corner_match = None
        corner_proximity = 0.0
        for cc in corner_cases:
            # Simple structural match; kc_runtime/confidence.py has the full logic
            from kc_runtime.confidence import match_corner_case
            proximity = match_corner_case(cc, raw, doc)
            if proximity > corner_proximity:
                corner_proximity = proximity
                corner_match = cc

        # Compute composite confidence
        rule_calibration = calibration.get(rule_id, {})
        composite_conf = compute_confidence(
            method_prior=raw.get("evidence_method", "fallback"),
            source_presence=raw.get("source_presence", 1.0),
            historical_accuracy=rule_calibration.get("weighted_accuracy", 0.8),
            corner_proximity=corner_proximity,
        )

        # Apply per-rule floor/ceiling if any
        floor = rule_meta.get("confidence_floor", 0.0)
        ceiling = rule_meta.get("confidence_ceiling", 1.0)
        composite_conf = max(floor, min(ceiling, composite_conf))

        # If corner case matched strongly, override verdict
        verdict = raw["verdict"]
        evidence = raw.get("evidence", "")
        if corner_match and corner_proximity >= 0.85:
            verdict = corner_match.get("expected_verdict", verdict)
            evidence = f"[corner-case override: {corner_match.get('reason', '')}] {evidence}"

        findings.append({
            "rule_id": rule_id,
            "doc": doc["source_path"],
            "verdict": verdict,
            "confidence": round(composite_conf, 4),
            "evidence": evidence,
            "citation": raw.get("citation", ""),
            "severity": rule_meta.get("severity", ""),
            "corner_case_id": corner_match.get("id") if corner_match and corner_proximity >= 0.85 else None,
        })

    return findings


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("input", nargs="?", help="Single doc to verify")
    parser.add_argument("--batch", type=Path, help="Directory of docs to verify")
    parser.add_argument("--rule", action="append", default=[],
                        help="Only run this rule (repeatable). Default: all rules in catalog.")
    parser.add_argument("--output", type=Path, default=Path("result.json"),
                        help="Where to write the result JSON (or output dir for --batch)")
    parser.add_argument("--dashboard", action="store_true",
                        help="Also render dashboard.html alongside result.json")
    args = parser.parse_args()

    if not args.input and not args.batch:
        err("provide either an input doc or --batch <dir>")
        return 1

    # Load bundled state
    manifest = json.loads((BUNDLE_ROOT / "manifest.json").read_text())
    catalog_raw = json.loads((BUNDLE_ROOT / "catalog.json").read_text())
    calibration = json.loads((BUNDLE_ROOT / "confidence_calibration.json").read_text())

    # Normalize catalog to dict-by-rule-id
    if isinstance(catalog_raw, list):
        catalog = {"rules": {r["id"]: r for r in catalog_raw}}
    else:
        catalog = catalog_raw if "rules" in catalog_raw else {"rules": catalog_raw}

    rule_ids = args.rule if args.rule else list(catalog["rules"].keys())
    info(f"Running {len(rule_ids)} rule(s) from {manifest['project_name']} bundle v{manifest['bundle_version']}")

    if args.batch:
        if not args.batch.is_dir():
            err(f"batch input is not a dir: {args.batch}")
            return 1
        args.output.mkdir(parents=True, exist_ok=True)
        all_findings = []
        for doc_path in sorted(args.batch.rglob("*")):
            if not doc_path.is_file() or doc_path.suffix.lower() not in {".pdf", ".md", ".docx", ".txt", ".html"}:
                continue
            info(f"  verifying: {doc_path.name}")
            doc = parse_input(doc_path)
            findings = verify_doc(doc, rule_ids, catalog, calibration)
            all_findings.extend(findings)
        result_path = args.output / "result.json"
    else:
        doc_path = Path(args.input).resolve()
        if not doc_path.exists():
            err(f"input doc doesn't exist: {doc_path}")
            return 1
        doc = parse_input(doc_path)
        all_findings = verify_doc(doc, rule_ids, catalog, calibration)
        result_path = args.output

    result = {
        "bundle": {
            "project": manifest["project_name"],
            "version": manifest["bundle_version"],
            "run_at": datetime.now(timezone.utc).isoformat(),
        },
        "findings": all_findings,
        "summary": {
            "total_findings": len(all_findings),
            "by_verdict": {
                v: sum(1 for f in all_findings if f["verdict"] == v)
                for v in {"pass", "fail", "needs-review", "error", "not-applicable"}
            },
            "by_severity": {
                s: sum(1 for f in all_findings if f["severity"] == s)
                for s in manifest["severity_vocab"]
            },
        },
    }
    result_path.parent.mkdir(parents=True, exist_ok=True)
    result_path.write_text(json.dumps(result, indent=2) + "\n")
    info(f"\nWrote {len(all_findings)} finding(s) to {result_path}")

    if args.dashboard:
        from kc_runtime.dashboard import render_html
        html_path = result_path.with_name("dashboard.html")
        render_html(result, calibration, catalog, html_path)
        info(f"Rendered dashboard: {html_path}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
